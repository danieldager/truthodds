# Copy this file to .env and fill in your values
# Then load it before running: export $(cat .env | xargs)

# LLM provider (extraction + verification + cache gate). DeepInfra, OpenAI-compatible.
DEEPINFRA_API_KEY=your-deepinfra-key-here

# Tier 3 evidence retrieval. Provider = "serper" (paid, production) or "tavily" (free 1k/mo, eval).
SEARCH_PROVIDER=tavily
SERPER_API_KEY=your-serper-key-here
TAVILY_API_KEY=your-tavily-key-here

# Tier 2 / fact-check harvester. Google Fact Check Tools API (free; enable the
# "Fact Check Tools API" in a Google Cloud project to get a key).
GOOGLE_FCTAPI_KEY=your-google-fctapi-key-here

# Tier 1 claims cache (Postgres + pgvector). Local dev: `docker compose up -d claims-db`.
NEON_DATABASE_URL=postgresql://factcheck:factcheck@localhost:5432/claims
JINA_API_KEY=
